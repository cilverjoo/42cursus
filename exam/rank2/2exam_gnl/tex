#include "get_next_line.h"

int		ft_strlen(char* str)
{
	int i = 0;
	if(str)
	{
		while(str[i])
			i++;
	}
	return i;
}

char	*ft_strjoin(char* str, char* add)
{	
	int idx = 0;
	int jdx = 0;
	int strlen = 0;
	int addlen = 0;
	char *res;
	strlen = ft_strlen(str);
	addlen = ft_strlen(add);
	res = (char*)malloc(sizeof(char) * (strlen + addlen + 1));
	while (idx <strlen)
	{
		res[idx] = str[idx];
		idx++;
	}
	while (jdx <addlen)
	{
		res[idx+jdx] = add[jdx];
		jdx++;
	}
	res[jdx+idx] = '\0';
	free(str);
	return res;
}
char	*ft_strdup(char* str)
{
	int idx = 0;
	char* res;
	int strlen;
	strlen = ft_strlen(str);
	res = (char*)malloc(sizeof(char)* (strlen + 1));
	while(idx < strlen)
	{
		res[idx] = str[idx];
		idx++;
	}
	res[idx] = '\0';
	return res;
}
char	*ft_strduplange(char *str, int start, int end)
{	
	int idx = 0;
	char* res;
	if (start >= end)
	{
		res = ft_strdup("");
		return res;
	}
	
	res = (char*)malloc(sizeof(char)*(end - start + 2));
	while (start <= end)
		res[idx++] = str[start++];
	res[idx] = '\0';
	return res;
}

int		ft_strchr(char *str, char c)
{
	int start = 0;
	int strlen = 0;
	strlen = ft_strlen(str);
	start = (strlen - 128 > 0 ? strlen - 128 + 1 : 0);

	while (start < strlen)
	{
		if (str[start] == c)
			return start;
		start++;
	}
	return (-1);
}
int		get_next_line(char **line)
{
	static char* st;
	char buffer[129];
	char* temp_st;
	int readed = 0;
	int n_idx = -1;
	buffer[128] = '\0';
	if(line == 0)
		return (-1);
	if (st)
	{
		if((n_idx = ft_strchr(st,'\n')) >= 0)
		{
			*line = ft_strduplange(st, 0, n_idx-1);
			temp_st = st;
			st = ft_strduplange(st,n_idx+1,ft_strlen(st) - 1);
			free(temp_st);
			return 1;
		}
	}
	while ((readed = read(0,buffer,128)) > 0)
	{
		buffer[readed] = '\0';
		st = ft_strjoin(st,buffer);
		if((n_idx = ft_strchr(st,'\n')) >= 0)
		{
			*line = ft_strduplange(st, 0, n_idx-1);
			temp_st = st;
			st = ft_strduplange(st,n_idx+1,ft_strlen(st) - 1);
			free(temp_st);
			return 1;
		}
	}
	if(st)
	{
		*line = ft_strdup(st);
		free(st);
		st = 0;
	}
	else
		*line = ft_strdup("");
	return 0;
}