#skip-networking=1일 때, 로컬에서만 수신하므로 false로 바꿔준다.
#bind-address = 0.0.0.0으로 줬을 때 모든 incoming connection을 허용하므로 편의상 이렇게 주자.
#alpine linux wiki에 보면, datadir을 아래의 값으로 지정하고 있다. 이는 pv의 위치이자 데이터가 저장될 위치이다.
[mysqld]
user=root
datadir=/var/lib/mysql/
port=3306
log-bin=/var/lib/mysql-bin
bind-address=0.0.0.0
skip-networking=0