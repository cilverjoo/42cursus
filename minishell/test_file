5. Return value of a process
0 : success (/bin/ls -l -> echo $?)
1 : file not found (/bin/ls -l invalid -> echo $?)
127 : cmd not found (asdf)
126 : is dir (/bin)
258 : syntax error (>>>>>)
130 : child int (cat -> Ctrl-C)
131 : child quit (cat -> Ctrl-\)
255 : invalid exit code (exit a | exit a -> echo $?)

